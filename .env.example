# FHE Project Board — Environment Variables
# Copy this file to .env and fill in your values

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/fhe_board

# JWT
JWT_SECRET=your_jwt_secret_here

# Microsoft Graph (email automation)
MS_TENANT_ID=your_tenant_id
MS_CLIENT_ID=your_client_id
MS_CLIENT_SECRET=your_client_secret

# GitHub Personal Access Token
# Used for: pushing to GitHub, triggering GitHub Actions workflows
# Scopes required: repo, workflow
# Rotate this token before expiry — update GH_PAT secret in all repos when rotating
GH_PAT=your_github_pat_here
